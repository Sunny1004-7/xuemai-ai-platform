{
  "font": "Microsoft YaHei",
  "font_size": 32,
  "measured_max_width": 1440,
  "safe_width": 1720,
  "single_line": true,
  "cues": [
    {
      "start": 0.696708,
      "end": 2.081749,
      "text": "各位评委老师好。",
      "width": 256.0
    },
    {
      "start": 2.5042079999999998,
      "end": 10.279416,
      "text": "下面向各位老师介绍我的作品学脉，一套面向学生学习和教师教学的AI个性化智慧教育平台。",
      "width": 1312.0
    },
    {
      "start": 12.6945926987061,
      "end": 16.74826291589649,
      "text": "学生要把课前准备、课堂理解和课后练习连起来；",
      "width": 704.0
    },
    {
      "start": 16.979644493222427,
      "end": 19.36499697319778,
      "text": "教师也要根据不同表现调整安排。",
      "width": 480.0
    },
    {
      "start": 19.787398914048058,
      "end": 24.59520401263093,
      "text": "学脉把课程资源、学习反馈和教学行动组织在同一平台。",
      "width": 800.0
    },
    {
      "start": 26.696708,
      "end": 30.102832000000003,
      "text": "这幅框架连接个人学习和班级教学。",
      "width": 512.0
    },
    {
      "start": 30.536916,
      "end": 33.335499,
      "text": "课程资料与学习记录提供共同依据。",
      "width": 512.0
    },
    {
      "start": 33.772916,
      "end": 37.471041,
      "text": "学生侧追踪知识状态，安排路径并检验理解；",
      "width": 640.0
    },
    {
      "start": 37.709833,
      "end": 39.994374,
      "text": "教师侧据此分组和编排教学。",
      "width": 416.0
    },
    {
      "start": 40.431791000000004,
      "end": 45.449999000000005,
      "text": "共享工具完成检索、生成与校验，新的作答继续更新下一步安排。",
      "width": 928.0
    },
    {
      "start": 48.696708,
      "end": 54.462625,
      "text": "先从登录页进入学生端，依次查看学习安排、课程学习和练习答疑。",
      "width": 960.0
    },
    {
      "start": 56.696708,
      "end": 58.245332000000005,
      "text": "首先介绍学生端。",
      "width": 256.0
    },
    {
      "start": 58.66775,
      "end": 64.912624,
      "text": "学习概览集中呈现当前任务和学习情况，学生进入后就能找到今天的学习入口。",
      "width": 1120.0
    },
    {
      "start": 67.696708,
      "end": 69.257041,
      "text": "接下来是目标与计划。",
      "width": 320.0
    },
    {
      "start": 69.691125,
      "end": 74.358874,
      "text": "学生设定目标和可用时间，系统结合先修基础安排活动。",
      "width": 800.0
    },
    {
      "start": 74.79625,
      "end": 79.650916,
      "text": "预算内路径说明今天先做什么，后续候选则帮助学生继续规划。",
      "width": 896.0
    },
    {
      "start": 85.696708,
      "end": 88.331791,
      "text": "下面进入课程学习，先看视频。",
      "width": 448.0
    },
    {
      "start": 88.765875,
      "end": 94.823832,
      "text": "字幕定位、随堂检查和时间戳笔记，帮助学生回到具体位置继续理解。",
      "width": 992.0
    },
    {
      "start": 98.696708,
      "end": 100.654207,
      "text": "课程资料按知识组织。",
      "width": 320.0
    },
    {
      "start": 101.08833299999999,
      "end": 105.160291,
      "text": "学生打开讲义，就能围绕当前内容阅读和核对例子。",
      "width": 736.0
    },
    {
      "start": 107.696708,
      "end": 110.46024899999999,
      "text": "知识图谱呈现完整课程网络。",
      "width": 416.0
    },
    {
      "start": 110.882708,
      "end": 117.664958,
      "text": "选择一个知识点，可以查看先修关系、学习状态和关联材料，再进入具体练习。",
      "width": 1120.0
    },
    {
      "start": 118.090666,
      "end": 122.47804099999999,
      "text": "这样，学生既能看到全局，也能找到当前需要补充的基础。",
      "width": 832.0
    },
    {
      "start": 127.696708,
      "end": 130.55374899999998,
      "text": "完成基础学习后，进入智能练习。",
      "width": 480.0
    },
    {
      "start": 130.987833,
      "end": 137.232708,
      "text": "这里完成教师提前发布的独立检查，提交后查看评分、解析和证据变化。",
      "width": 1024.0
    },
    {
      "start": 137.670083,
      "end": 140.795791,
      "text": "这次作答会在后面的教师结果中继续出现。",
      "width": 608.0
    },
    {
      "start": 146.696708,
      "end": 149.565416,
      "text": "错题与复习保存需要继续巩固的内容。",
      "width": 544.0
    },
    {
      "start": 149.987833,
      "end": 155.356541,
      "text": "学生可查看错误原因，再进入订正和到期复测，学习记录持续保留。",
      "width": 960.0
    },
    {
      "start": 158.696708,
      "end": 162.242999,
      "text": "交互实验室把抽象过程变成可操作的状态。",
      "width": 608.0
    },
    {
      "start": 162.67708299999998,
      "end": 169.903291,
      "text": "以栈为例，逐次压栈、出栈并查看返回值，学生可以对照轨迹检验自己对顺序的理解。",
      "width": 1216.0
    },
    {
      "start": 174.696708,
      "end": 176.911208,
      "text": "接下来是AI学习伙伴。",
      "width": 320.0
    },
    {
      "start": 177.34533299999998,
      "end": 183.8355,
      "text": "这里回看已保存的真实辅导，问题、附件引用和理解检查围绕同一知识展开。",
      "width": 1088.0
    },
    {
      "start": 184.272916,
      "end": 188.566832,
      "text": "学生能够打开原资料核对解释，再通过独立回答继续学习；",
      "width": 832.0
    },
    {
      "start": 188.793916,
      "end": 191.125207,
      "text": "模型和语音入口也集中在这里。",
      "width": 448.0
    },
    {
      "start": 195.696708,
      "end": 201.170541,
      "text": "课堂互动承接即时提问与回答，让学生解释进入教师的课堂观察。",
      "width": 928.0
    },
    {
      "start": 203.696708,
      "end": 205.12854099999998,
      "text": "学生端介绍完毕。",
      "width": 256.0
    },
    {
      "start": 205.562625,
      "end": 207.905583,
      "text": "现在从登录页进入教师端。",
      "width": 384.0
    },
    {
      "start": 211.696708,
      "end": 217.742999,
      "text": "教师进入教学工作台后，可以集中查看当前课程、教学任务和待办事项。",
      "width": 1024.0
    },
    {
      "start": 220.696708,
      "end": 224.289708,
      "text": "课程与班级用于组织章节、知识和学生。",
      "width": 576.0
    },
    {
      "start": 224.72383299999998,
      "end": 229.99908299999998,
      "text": "教师可以查看课程结构与班级成员，为后续资料和任务确定对象。",
      "width": 928.0
    },
    {
      "start": 233.696708,
      "end": 236.915874,
      "text": "AI备课与资料集中保存讲义和教案。",
      "width": 512.0
    },
    {
      "start": 237.35,
      "end": 242.590208,
      "text": "教师可以查看课程内容与版本，围绕教学目标组织学习材料。",
      "width": 864.0
    },
    {
      "start": 245.696708,
      "end": 251.252332,
      "text": "教师知识图谱沿用同一课程网络，并提供知识和先修关系的编辑入口。",
      "width": 992.0
    },
    {
      "start": 258.696708,
      "end": 264.883166,
      "text": "视频教学管理课程片段、字幕与检查题，使观看内容能够连接具体知识。",
      "width": 1024.0
    },
    {
      "start": 267.696708,
      "end": 270.775707,
      "text": "题库与作业负责审核题目和发布任务。",
      "width": 544.0
    },
    {
      "start": 271.209833,
      "end": 275.246707,
      "text": "先查看学生刚刚完成的检查，结果与前面的作答对应。",
      "width": 768.0
    },
    {
      "start": 275.684125,
      "end": 278.973332,
      "text": "教师随后选择题目，发布新的巩固任务。",
      "width": 576.0
    },
    {
      "start": 279.41075,
      "end": 283.24904100000003,
      "text": "新任务的后续作答将另行统计，便于继续跟进。",
      "width": 672.0
    },
    {
      "start": 291.696708,
      "end": 297.76633300000003,
      "text": "教师课堂互动展示学生回答，教师可以查看不同解释，并给出后续反馈。",
      "width": 1024.0
    },
    {
      "start": 300.696708,
      "end": 303.00466600000004,
      "text": "下面重点看学情与分层。",
      "width": 352.0
    },
    {
      "start": 303.42708300000004,
      "end": 309.426624,
      "text": "知识矩阵可以追溯具体作答，错因分组则把相近困难连接到针对性题目。",
      "width": 1024.0
    },
    {
      "start": 309.86400000000003,
      "end": 314.601833,
      "text": "教师根据证据选择教学对象，确认后形成可发布任务。",
      "width": 768.0
    },
    {
      "start": 321.696708,
      "end": 324.19162400000005,
      "text": "最后是独立的AI教学助手。",
      "width": 384.0
    },
    {
      "start": 324.62570800000003,
      "end": 332.482707,
      "text": "这里回看真实生成的讲评课方案，助手读取班级证据和教师目标，组织教学环节与分组练习。",
      "width": 1312.0
    },
    {
      "start": 332.92008300000003,
      "end": 337.821499,
      "text": "教师能够编辑并保存教案，再确认具体任务，使建议进入教学。",
      "width": 896.0
    },
    {
      "start": 343.696708,
      "end": 348.481333,
      "text": "下面回看AI协同开发，先看师生课程如何接通。",
      "width": 672.0
    },
    {
      "start": 350.69610104602515,
      "end": 355.5789764121339,
      "text": "我先说明登录和课程接口，AI据此连接页面、辅导和后端。",
      "width": 832.0
    },
    {
      "start": 357.695303526971,
      "end": 362.5845580394191,
      "text": "运行测试时，三项接口检查失败，发现演示数据写入出错。",
      "width": 832.0
    },
    {
      "start": 364.696708,
      "end": 369.07241600000003,
      "text": "AI根据报错检查写入语句，删去多出的一个占位符。",
      "width": 736.0
    },
    {
      "start": 371.696708,
      "end": 375.97895800000003,
      "text": "再次运行登录、图谱和作答，接口都返回了正常结果。",
      "width": 768.0
    },
    {
      "start": 378.696708,
      "end": 383.34112500000003,
      "text": "最后按功能提交代码，师生两端开始共用同一份课程记录。",
      "width": 832.0
    },
    {
      "start": 385.696708,
      "end": 387.65420800000004,
      "text": "第二个例子是知识图谱。",
      "width": 352.0
    },
    {
      "start": 388.07662500000004,
      "end": 390.478041,
      "text": "我希望节点清楚，连线也能看清。",
      "width": 480.0
    },
    {
      "start": 392.696708,
      "end": 397.50466600000004,
      "text": "先运行几何检查，发现数据结构课程有九处连线遮挡。",
      "width": 768.0
    },
    {
      "start": 399.696708,
      "end": 404.399541,
      "text": "AI补充绕行搜索，让受阻的连线从节点之间的空隙通过。",
      "width": 800.0
    },
    {
      "start": 406.696708,
      "end": 410.87383300000005,
      "text": "接着用两门课程和三组不同规模的网络重新检查。",
      "width": 704.0
    },
    {
      "start": 413.696708,
      "end": 417.53504100000004,
      "text": "五组结果中，节点碰撞和连线遮挡都降到了零。",
      "width": 672.0
    },
    {
      "start": 420.696708,
      "end": 425.084082,
      "text": "再检查页面里的拖动、搜索和全屏，随后保存这次修改。",
      "width": 800.0
    },
    {
      "start": 427.696708,
      "end": 432.364457,
      "text": "第三个例子，教师希望根据班级错题设计一节讲评课。",
      "width": 768.0
    },
    {
      "start": 434.696708,
      "end": 438.943916,
      "text": "专项测试发现，系统只分析错误，却没有给出要求的教案。",
      "width": 832.0
    },
    {
      "start": 441.69610104602515,
      "end": 446.56738362970714,
      "text": "AI调整判断顺序，先识别要写教案，再读取班级错题。",
      "width": 768.0
    },
    {
      "start": 448.696708,
      "end": 453.271041,
      "text": "用原来的教师要求再次测试，两项专项检查全部通过。",
      "width": 768.0
    },
    {
      "start": 455.696708,
      "end": 459.815416,
      "text": "随后运行原有业务和浏览器测试，继续核对师生操作。",
      "width": 768.0
    },
    {
      "start": 462.696708,
      "end": 467.04904100000005,
      "text": "保存代码后，再核对教案编辑、任务发布和学生反馈。",
      "width": 768.0
    },
    {
      "start": 469.696708,
      "end": 473.418249,
      "text": "以上是学脉的主要功能与AI协同开发过程。",
      "width": 608.0
    },
    {
      "start": 473.85233300000004,
      "end": 476.32383200000004,
      "text": "感谢各位评委老师的观看与指导。",
      "width": 480.0
    }
  ]
}