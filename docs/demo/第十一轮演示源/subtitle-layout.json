{
  "font": "Microsoft YaHei",
  "font_size": 32,
  "measured_max_width": 1440,
  "safe_width": 1720,
  "single_line": true,
  "cues": [
    {
      "start": 0.701541,
      "end": 2.2190410000000003,
      "text": "各位评委老师好。",
      "width": 256.0
    },
    {
      "start": 2.7005,
      "end": 11.266998999999998,
      "text": "下面向各位老师介绍我的作品学脉，一套面向学生学习和教师教学的AI个性化智慧教育平台。",
      "width": 1312.0
    },
    {
      "start": 14.701540999999999,
      "end": 19.260291,
      "text": "学生要把课前准备、课堂理解和课后练习连起来；",
      "width": 704.0
    },
    {
      "start": 19.534,
      "end": 22.211375,
      "text": "教师也要根据不同表现调整安排。",
      "width": 480.0
    },
    {
      "start": 22.705666,
      "end": 28.114958,
      "text": "学脉把课程资源、学习反馈和教学行动组织在同一平台。",
      "width": 800.0
    },
    {
      "start": 31.701541000000002,
      "end": 35.448458,
      "text": "这幅框架连接个人学习和班级教学。",
      "width": 512.0
    },
    {
      "start": 35.942791,
      "end": 39.019583,
      "text": "课程资料与学习记录提供共同依据。",
      "width": 512.0
    },
    {
      "start": 39.512375,
      "end": 43.581458,
      "text": "学生侧追踪知识状态，安排路径并检验理解；",
      "width": 640.0
    },
    {
      "start": 43.855166,
      "end": 46.364958,
      "text": "教师侧据此分组和编排教学。",
      "width": 416.0
    },
    {
      "start": 46.85775,
      "end": 52.383,
      "text": "共享工具完成检索、生成与校验，新的作答继续更新下一步安排。",
      "width": 928.0
    },
    {
      "start": 55.6988903313253,
      "end": 57.355134568273094,
      "text": "首先介绍学生端。",
      "width": 256.0
    },
    {
      "start": 57.821374016064254,
      "end": 64.52276258032128,
      "text": "学习概览集中呈现当前任务和学习情况，学生进入后就能找到今天的学习入口。",
      "width": 1120.0
    },
    {
      "start": 66.70154099999999,
      "end": 68.412375,
      "text": "接下来是目标与计划。",
      "width": 320.0
    },
    {
      "start": 68.906708,
      "end": 74.045333,
      "text": "学生设定目标和可用时间，系统结合先修基础安排活动。",
      "width": 800.0
    },
    {
      "start": 74.538125,
      "end": 79.883,
      "text": "预算内路径说明今天先做什么，后续候选则帮助学生继续规划。",
      "width": 896.0
    },
    {
      "start": 84.70154099999999,
      "end": 87.59795799999999,
      "text": "下面进入课程学习，先看视频。",
      "width": 448.0
    },
    {
      "start": 88.09224999999999,
      "end": 94.764416,
      "text": "字幕定位、随堂检查和时间戳笔记，帮助学生回到具体位置继续理解。",
      "width": 992.0
    },
    {
      "start": 97.69724697761194,
      "end": 99.75959772388059,
      "text": "课程资料按知识组织。",
      "width": 320.0
    },
    {
      "start": 100.22875797263681,
      "end": 104.52493043532338,
      "text": "学生打开讲义，就能围绕当前内容阅读和核对例子。",
      "width": 736.0
    },
    {
      "start": 106.70154099999999,
      "end": 109.739707,
      "text": "知识图谱呈现完整课程网络。",
      "width": 416.0
    },
    {
      "start": 110.221125,
      "end": 117.69224899999999,
      "text": "选择一个知识点，可以查看先修关系、学习状态和关联材料，再进入具体练习。",
      "width": 1120.0
    },
    {
      "start": 118.17216599999999,
      "end": 123.001541,
      "text": "这样，学生既能看到全局，也能找到当前需要补充的基础。",
      "width": 832.0
    },
    {
      "start": 126.70154099999999,
      "end": 129.842791,
      "text": "完成基础学习后，进入智能练习。",
      "width": 480.0
    },
    {
      "start": 130.337125,
      "end": 137.21545799999998,
      "text": "这里完成教师提前发布的独立检查，提交后查看评分、解析和证据变化。",
      "width": 1024.0
    },
    {
      "start": 137.70825,
      "end": 141.145875,
      "text": "这次作答会在后面的教师结果中继续出现。",
      "width": 608.0
    },
    {
      "start": 145.701541,
      "end": 148.85566599999999,
      "text": "错题与复习保存需要继续巩固的内容。",
      "width": 544.0
    },
    {
      "start": 149.337125,
      "end": 155.248957,
      "text": "学生可查看错误原因，再进入订正和到期复测，学习记录持续保留。",
      "width": 960.0
    },
    {
      "start": 157.701541,
      "end": 161.603083,
      "text": "交互实验室把抽象过程变成可操作的状态。",
      "width": 608.0
    },
    {
      "start": 162.09741599999998,
      "end": 170.058249,
      "text": "以栈为例，逐次压栈、出栈并查看返回值，学生可以对照轨迹检验自己对顺序的理解。",
      "width": 1216.0
    },
    {
      "start": 173.701541,
      "end": 176.134,
      "text": "接下来是AI学习伙伴。",
      "width": 320.0
    },
    {
      "start": 176.628333,
      "end": 183.777291,
      "text": "这里回看已保存的真实辅导，问题、附件引用和理解检查围绕同一知识展开。",
      "width": 1088.0
    },
    {
      "start": 184.270083,
      "end": 188.99641599999998,
      "text": "学生能够打开原资料核对解释，再通过独立回答继续学习；",
      "width": 832.0
    },
    {
      "start": 189.257208,
      "end": 191.81854099999998,
      "text": "模型和语音入口也集中在这里。",
      "width": 448.0
    },
    {
      "start": 196.69808602941177,
      "end": 202.52422228950402,
      "text": "课堂互动承接即时提问与回答，让学生解释进入教师的课堂观察。",
      "width": 928.0
    },
    {
      "start": 204.69783104354354,
      "end": 207.88934443193193,
      "text": "学生端介绍完毕，下面进入教师端。",
      "width": 512.0
    },
    {
      "start": 208.36196352602602,
      "end": 211.52870723223222,
      "text": "教学工作台集中呈现课程和待办。",
      "width": 480.0
    },
    {
      "start": 213.701541,
      "end": 217.65462399999998,
      "text": "课程与班级用于组织章节、知识和学生。",
      "width": 576.0
    },
    {
      "start": 218.148958,
      "end": 223.95775,
      "text": "教师可以查看课程结构与班级成员，为后续资料和任务确定对象。",
      "width": 928.0
    },
    {
      "start": 226.7012759787472,
      "end": 230.23300375652497,
      "text": "AI备课与资料集中保存讲义和教案。",
      "width": 512.0
    },
    {
      "start": 230.725786549217,
      "end": 236.48111156785978,
      "text": "教师可以查看课程内容与版本，围绕教学目标组织学习材料。",
      "width": 864.0
    },
    {
      "start": 238.701541,
      "end": 244.819583,
      "text": "教师知识图谱沿用同一课程网络，并提供知识和先修关系的编辑入口。",
      "width": 992.0
    },
    {
      "start": 247.70117309782609,
      "end": 254.4907643115942,
      "text": "视频教学管理课程片段、字幕与检查题，使观看内容能够连接具体知识。",
      "width": 1024.0
    },
    {
      "start": 256.701541,
      "end": 260.087666,
      "text": "题库与作业负责审核题目和发布任务。",
      "width": 544.0
    },
    {
      "start": 260.58195800000004,
      "end": 265.02474900000004,
      "text": "先查看学生刚刚完成的检查，结果与前面的作答对应。",
      "width": 768.0
    },
    {
      "start": 265.51754100000005,
      "end": 269.135582,
      "text": "教师随后选择题目，发布新的巩固任务。",
      "width": 576.0
    },
    {
      "start": 269.628333,
      "end": 273.85208300000005,
      "text": "新任务的后续作答将另行统计，便于继续跟进。",
      "width": 672.0
    },
    {
      "start": 280.701541,
      "end": 287.38658300000003,
      "text": "教师课堂互动展示学生回答，教师可以查看不同解释，并给出后续反馈。",
      "width": 1024.0
    },
    {
      "start": 289.701541,
      "end": 292.237124,
      "text": "下面重点看学情与分层。",
      "width": 352.0
    },
    {
      "start": 292.718541,
      "end": 299.326291,
      "text": "知识矩阵可以追溯具体作答，错因分组则把相近困难连接到针对性题目。",
      "width": 1024.0
    },
    {
      "start": 299.81908300000003,
      "end": 305.03504100000004,
      "text": "教师根据证据选择教学对象，确认后形成可发布任务。",
      "width": 768.0
    },
    {
      "start": 310.701541,
      "end": 313.443333,
      "text": "最后是独立的AI教学助手。",
      "width": 384.0
    },
    {
      "start": 313.937625,
      "end": 322.594333,
      "text": "这里回看真实生成的讲评课方案，助手读取班级证据和教师目标，组织教学环节与分组练习。",
      "width": 1312.0
    },
    {
      "start": 323.087125,
      "end": 328.48350000000005,
      "text": "教师能够编辑并保存教案，再确认具体任务，使建议进入教学。",
      "width": 896.0
    },
    {
      "start": 333.701541,
      "end": 336.816999,
      "text": "下面是AI协同过程复现展示。",
      "width": 416.0
    },
    {
      "start": 337.31133300000005,
      "end": 340.65875,
      "text": "先回看课程对象与权限的协作指令。",
      "width": 512.0
    },
    {
      "start": 341.151541,
      "end": 346.457707,
      "text": "Codex先固定接口契约，前后端与人工智能模块共用课程标识。",
      "width": 895.0
    },
    {
      "start": 346.95050000000003,
      "end": 351.81854100000004,
      "text": "联测发现初始化错误，三个路由测试被同一个数据问题阻断。",
      "width": 864.0
    },
    {
      "start": 352.31133300000005,
      "end": 357.050499,
      "text": "反馈后，代码将知识点种子的八个占位符修正为七个。",
      "width": 768.0
    },
    {
      "start": 357.530416,
      "end": 363.777333,
      "text": "修复后的登录、图谱和作答返回实际结果，记录进入同一数据库。",
      "width": 928.0
    },
    {
      "start": 364.270083,
      "end": 370.310833,
      "text": "中文提交保留数据初始化和课程授权，后续功能沿用这些对象。",
      "width": 896.0
    },
    {
      "start": 370.803625,
      "end": 374.498958,
      "text": "师生页面由此能够继续使用同一份课程记录。",
      "width": 640.0
    },
    {
      "start": 377.201541,
      "end": 379.31183200000004,
      "text": "第二条来自知识网络。",
      "width": 320.0
    },
    {
      "start": 379.806166,
      "end": 383.669083,
      "text": "原始要求是改善拥挤的布局与阅读体验。",
      "width": 576.0
    },
    {
      "start": 384.161875,
      "end": 389.815957,
      "text": "实际几何检查发现九处连线遮挡，问题被保留在验证记录里。",
      "width": 864.0
    },
    {
      "start": 390.295875,
      "end": 395.885583,
      "text": "Codex增加空白通道搜索，使受阻连线继续寻找可用路径。",
      "width": 831.0
    },
    {
      "start": 396.378333,
      "end": 402.457708,
      "text": "两门真实课程和不同规模网络使用固定输入，分别检查几何结果。",
      "width": 928.0
    },
    {
      "start": 402.95050000000003,
      "end": 407.61233300000004,
      "text": "改进后，全部案例的节点碰撞与连线遮挡均为零。",
      "width": 704.0
    },
    {
      "start": 408.09225000000004,
      "end": 413.901041,
      "text": "代码、固定输入和结果一起提交，再检查页面中的相机与全屏。",
      "width": 896.0
    },
    {
      "start": 414.393791,
      "end": 417.844291,
      "text": "相同输入可以再次执行，逐项核对。",
      "width": 512.0
    },
    {
      "start": 420.701541,
      "end": 426.36854100000005,
      "text": "第三条核查教师要求，一句指令同时包含班级错误与教学设计。",
      "width": 896.0
    },
    {
      "start": 426.86287500000003,
      "end": 432.517,
      "text": "专项测试真实失败，系统只返回学情分析，遗漏讲评课产物。",
      "width": 864.0
    },
    {
      "start": 433.009791,
      "end": 439.19225,
      "text": "Codex调整优先级，先识别教学产物，再使用班级错误作为证据。",
      "width": 927.0
    },
    {
      "start": 439.685041,
      "end": 445.635583,
      "text": "同一专项重新执行，两项通过，教学设计与轻量讨论分别核查。",
      "width": 896.0
    },
    {
      "start": 446.128333,
      "end": 451.52474900000004,
      "text": "随后验证既有业务和双端页面，回归结果保留当时的执行记录。",
      "width": 896.0
    },
    {
      "start": 452.01754100000005,
      "end": 457.968041,
      "text": "中文提交保存修复，真实教学方案继续进入任务发布和学生反馈。",
      "width": 928.0
    },
    {
      "start": 464.201541,
      "end": 467.62629100000004,
      "text": "以上是学脉的主要功能与AI协同过程。",
      "width": 544.0
    },
    {
      "start": 468.120625,
      "end": 470.83662400000003,
      "text": "感谢各位评委老师的观看与指导。",
      "width": 480.0
    }
  ]
}