{
  "font": "Microsoft YaHei",
  "font_size": 32,
  "measured_max_width": 1440,
  "safe_width": 1720,
  "single_line": true,
  "cues": [
    {
      "start": 0.701541,
      "end": 2.2190410000000003,
      "text": "各位评委老师好。",
      "width": 256.0
    },
    {
      "start": 2.7005,
      "end": 8.122666,
      "text": "学生做完一道题，常常知道了答案，却还不清楚下一步该学什么。",
      "width": 928.0
    },
    {
      "start": 14.701540999999999,
      "end": 18.384,
      "text": "教师看到成绩，也需要判断不同学生的困难。",
      "width": 640.0
    },
    {
      "start": 18.878332999999998,
      "end": 25.692248999999997,
      "text": "围绕这些问题，我们设计了学脉，把课程学习、个性化辅导和教学协作连接在一起。",
      "width": 1184.0
    },
    {
      "start": 30.69901119845361,
      "end": 34.87023864690722,
      "text": "这张图汇集课程结构、资料和学习证据。",
      "width": 576.0
    },
    {
      "start": 35.34976535652921,
      "end": 41.883341241408935,
      "text": "学生侧更新知识状态，按照先修与时间安排学习，再通过辅导检验理解。",
      "width": 1024.0
    },
    {
      "start": 42.3613643685567,
      "end": 46.11793653350516,
      "text": "教师侧依据错因分层，结合目标编排教学。",
      "width": 608.0
    },
    {
      "start": 46.595918707044675,
      "end": 52.513767817869415,
      "text": "课程工具与模型服务支持这些操作，新的作答和反馈继续形成依据。",
      "width": 960.0
    },
    {
      "start": 54.701541,
      "end": 59.440707,
      "text": "师生各有工作区，课程与学习记录在两端保持关联。",
      "width": 736.0
    },
    {
      "start": 63.068540999999996,
      "end": 65.127332,
      "text": "从陈星河的一次错题开始。",
      "width": 384.0
    },
    {
      "start": 65.621625,
      "end": 71.095375,
      "text": "系统记录这次错误，呈现知识状态、证据量和继续学习的入口。",
      "width": 896.0
    },
    {
      "start": 71.58812499999999,
      "end": 76.27574899999999,
      "text": "路径读取个人目标和时间预算，安排具体的前置活动。",
      "width": 768.0
    },
    {
      "start": 82.148541,
      "end": 87.351666,
      "text": "课程网络连接当前概念与前置知识，方便学生定位。",
      "width": 736.0
    },
    {
      "start": 87.845958,
      "end": 91.902166,
      "text": "压入四十八再弹出，结构和返回值同步变化。",
      "width": 640.0
    },
    {
      "start": 92.394916,
      "end": 96.50266599999999,
      "text": "学生带上原题和操作记录，继续讨论自己的困惑。",
      "width": 704.0
    },
    {
      "start": 101.33854099999999,
      "end": 103.551958,
      "text": "这次请求使用官方模型。",
      "width": 352.0
    },
    {
      "start": 104.046291,
      "end": 108.19266599999999,
      "text": "解释结合课程材料与附件，并给出理解检查。",
      "width": 640.0
    },
    {
      "start": 108.685458,
      "end": 112.41945799999999,
      "text": "打开引用，可以查看上传的丙牌操作记录。",
      "width": 608.0
    },
    {
      "start": 112.91225,
      "end": 118.012291,
      "text": "学生完成检查，评分结果保存到原有会话和学习记录。",
      "width": 768.0
    },
    {
      "start": 121.758541,
      "end": 127.554416,
      "text": "回看这段解释，模型用甲乙丙牌说明最后压入的元素为什么先离开。",
      "width": 960.0
    },
    {
      "start": 128.04874999999998,
      "end": 132.942541,
      "text": "学生既能看到对应材料，也能通过下一道题检查自己的理解。",
      "width": 864.0
    },
    {
      "start": 133.43533299999999,
      "end": 136.202874,
      "text": "辅导围绕这名学生的具体错误展开。",
      "width": 512.0
    },
    {
      "start": 139.958541,
      "end": 143.344624,
      "text": "历史会话保留原题、引用和检查。",
      "width": 480.0
    },
    {
      "start": 143.838958,
      "end": 147.302374,
      "text": "学生再次打开时，可以接着同一个问题学习。",
      "width": 640.0
    },
    {
      "start": 150.958541,
      "end": 157.347208,
      "text": "教师从知识矩阵进入陈星河的作答，把班级状态追溯到具体题目。",
      "width": 928.0
    },
    {
      "start": 157.841541,
      "end": 165.956999,
      "text": "随后要求安排三十分钟讲评课，教学助手读取班级证据，组织教学环节与群组任务。",
      "width": 1184.0
    },
    {
      "start": 166.449791,
      "end": 172.58070800000002,
      "text": "教师修改方案标题，核对活动安排，保存为可继续编辑的课程教案。",
      "width": 960.0
    },
    {
      "start": 173.0735,
      "end": 175.841,
      "text": "方案经过校验，等待教师确认。",
      "width": 448.0
    },
    {
      "start": 181.418541,
      "end": 183.283999,
      "text": "教师端面向整个班级。",
      "width": 320.0
    },
    {
      "start": 183.778333,
      "end": 189.677291,
      "text": "方案分为五分钟发现问题、十五分钟对照追踪和十分钟迁移复测。",
      "width": 928.0
    },
    {
      "start": 190.170083,
      "end": 198.710791,
      "text": "群组与题目来自课程工具，时间和对象由程序校验，教师据此判断哪些内容适合这次教学。",
      "width": 1280.0
    },
    {
      "start": 201.018541,
      "end": 204.984541,
      "text": "发布表单带入五名学生，其中包括陈星河。",
      "width": 608.0
    },
    {
      "start": 205.478875,
      "end": 209.625249,
      "text": "教师确认目标学生与题目，再发布独立复测任务。",
      "width": 704.0
    },
    {
      "start": 211.851541,
      "end": 217.183499,
      "text": "陈星河接收该任务，独立选择答案并提交，记录保留任务标识。",
      "width": 896.0
    },
    {
      "start": 217.677833,
      "end": 224.465958,
      "text": "教师查看同一任务的结果，确认他已经完成，并对照新增作答和发布前后的状态。",
      "width": 1152.0
    },
    {
      "start": 224.95875,
      "end": 230.999457,
      "text": "随后继续发起反馈，请学生解释两种移出顺序，并举出生活中的例子。",
      "width": 992.0
    },
    {
      "start": 231.49225,
      "end": 237.46854100000002,
      "text": "这几步通过同一课程、学生和任务相互关联，便于回看后续学习。",
      "width": 928.0
    },
    {
      "start": 242.551541,
      "end": 247.741749,
      "text": "学生回到课堂互动，写下对栈和队列的理解，再提交自己的例子。",
      "width": 928.0
    },
    {
      "start": 248.23608299999998,
      "end": 250.34641599999998,
      "text": "教师随后查看这条回答。",
      "width": 352.0
    },
    {
      "start": 250.83916599999998,
      "end": 257.434041,
      "text": "一次错误经过材料、辅导、复测和反馈，形成了前后对应的教学过程。",
      "width": 992.0
    },
    {
      "start": 257.926791,
      "end": 261.647916,
      "text": "每一步都保存具体的课程对象与实际记录。",
      "width": 608.0
    },
    {
      "start": 266.05154100000004,
      "end": 268.70308300000005,
      "text": "课程建设也可以接入新的主题。",
      "width": 448.0
    },
    {
      "start": 269.19741600000003,
      "end": 275.74070800000004,
      "text": "这里是通过正常接口创建的信息素养微单元，讲义讨论怎样追溯消息来源。",
      "width": 1056.0
    },
    {
      "start": 276.23350000000005,
      "end": 284.55516600000004,
      "text": "学生进入新知识和习题，老师发布任务、查看结果并继续反馈，同一套流程沿用到新内容。",
      "width": 1280.0
    },
    {
      "start": 288.918541,
      "end": 293.077791,
      "text": "Python课程同样提供知识关系、视频与练习。",
      "width": 653.0
    },
    {
      "start": 293.572166,
      "end": 299.935041,
      "text": "切换课程后，状态和材料随之更新，学生能够沿相同的方式继续学习。",
      "width": 992.0
    },
    {
      "start": 302.185541,
      "end": 305.932457,
      "text": "七百二十种场景，先修与预算违规均为零。",
      "width": 608.0
    },
    {
      "start": 306.41391600000003,
      "end": 311.475208,
      "text": "相对可行贪心，平均计划效用提高约百分之2.80。",
      "width": 705.0
    },
    {
      "start": 314.185541,
      "end": 319.942749,
      "text": "接下来回看三条真实开发链，先看课程对象与权限的协作指令。",
      "width": 896.0
    },
    {
      "start": 320.43708300000003,
      "end": 325.743249,
      "text": "Codex先固定接口契约，前后端与人工智能模块共用课程标识。",
      "width": 895.0
    },
    {
      "start": 326.236041,
      "end": 331.104083,
      "text": "联测发现初始化错误，三个路由测试被同一个数据问题阻断。",
      "width": 864.0
    },
    {
      "start": 331.596875,
      "end": 336.336041,
      "text": "反馈后，代码将知识点种子的八个占位符修正为七个。",
      "width": 768.0
    },
    {
      "start": 336.815958,
      "end": 343.062874,
      "text": "修复后的登录、图谱和作答返回实际结果，记录进入同一数据库。",
      "width": 928.0
    },
    {
      "start": 343.555666,
      "end": 349.596375,
      "text": "中文提交保留数据初始化和课程授权，后续功能沿用这些对象。",
      "width": 896.0
    },
    {
      "start": 350.089166,
      "end": 353.784499,
      "text": "师生页面由此能够继续使用同一份课程记录。",
      "width": 640.0
    },
    {
      "start": 359.185541,
      "end": 361.295832,
      "text": "第二条来自知识网络。",
      "width": 320.0
    },
    {
      "start": 361.790166,
      "end": 365.653083,
      "text": "原始要求是改善拥挤的布局与阅读体验。",
      "width": 576.0
    },
    {
      "start": 366.145875,
      "end": 371.799957,
      "text": "实际几何检查发现九处连线遮挡，问题被保留在验证记录里。",
      "width": 864.0
    },
    {
      "start": 372.279875,
      "end": 377.86958300000003,
      "text": "Codex增加空白通道搜索，使受阻连线继续寻找可用路径。",
      "width": 831.0
    },
    {
      "start": 378.362333,
      "end": 384.441708,
      "text": "两门真实课程和不同规模网络使用固定输入，分别检查几何结果。",
      "width": 928.0
    },
    {
      "start": 384.9345,
      "end": 389.596333,
      "text": "改进后，全部案例的节点碰撞与连线遮挡均为零。",
      "width": 704.0
    },
    {
      "start": 390.07625,
      "end": 395.885041,
      "text": "代码、固定输入和结果一起提交，再检查页面中的相机与全屏。",
      "width": 896.0
    },
    {
      "start": 396.377791,
      "end": 399.82829100000004,
      "text": "相同输入可以再次执行，逐项核对。",
      "width": 512.0
    },
    {
      "start": 404.185541,
      "end": 409.85254100000003,
      "text": "第三条核查教师要求，一句指令同时包含班级错误与教学设计。",
      "width": 896.0
    },
    {
      "start": 410.346875,
      "end": 416.001,
      "text": "专项测试真实失败，系统只返回学情分析，遗漏讲评课产物。",
      "width": 864.0
    },
    {
      "start": 416.493791,
      "end": 422.67625,
      "text": "Codex调整优先级，先识别教学产物，再使用班级错误作为证据。",
      "width": 927.0
    },
    {
      "start": 423.169041,
      "end": 429.11958300000003,
      "text": "同一专项重新执行，两项通过，教学设计与轻量讨论分别核查。",
      "width": 896.0
    },
    {
      "start": 429.612333,
      "end": 435.008749,
      "text": "随后验证既有业务和双端页面，回归结果保留当时的执行记录。",
      "width": 896.0
    },
    {
      "start": 435.501541,
      "end": 441.452041,
      "text": "中文提交保存修复，真实教学方案继续进入任务发布和学生反馈。",
      "width": 928.0
    },
    {
      "start": 449.185541,
      "end": 455.136082,
      "text": "以上是学脉的主要功能与开发过程，感谢各位评委老师的观看与指导。",
      "width": 992.0
    }
  ]
}