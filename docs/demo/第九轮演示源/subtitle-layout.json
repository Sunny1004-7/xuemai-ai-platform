{
  "font": "Microsoft YaHei",
  "font_size": 32,
  "measured_max_width": 1440,
  "safe_width": 1720,
  "single_line": true,
  "cues": [
    {
      "start": 0.701541,
      "end": 5.569582,
      "text": "各位评委老师好，我是西安交通大学软件工程专业的刘嘉程。",
      "width": 864.0
    },
    {
      "start": 6.063916,
      "end": 10.300498999999999,
      "text": "学脉连接课程学习、个性化辅导与教学协作。",
      "width": 640.0
    },
    {
      "start": 16.6970943597561,
      "end": 21.7753143154102,
      "text": "课前要准备材料，课堂需要收集回答，课后还要跟进学习。",
      "width": 832.0
    },
    {
      "start": 22.243581333148562,
      "end": 28.738862971175166,
      "text": "学生往往不清楚下一步先补什么，教师则要从全班作答中判断谁需要帮助。",
      "width": 1056.0
    },
    {
      "start": 29.20569567627495,
      "end": 36.51423162416852,
      "text": "学脉把资料、活动、辅导和任务关联起来，让每次反馈都能接上后续学习与教学安排。",
      "width": 1216.0
    },
    {
      "start": 38.69673797820285,
      "end": 44.10045162737248,
      "text": "这张图从师生输入出发，汇集课程结构、资料和学习证据。",
      "width": 832.0
    },
    {
      "start": 44.56663284030249,
      "end": 50.8788228165777,
      "text": "学生侧用知识追踪更新状态，路径规划安排先修与时间，个人辅导检验理解。",
      "width": 1088.0
    },
    {
      "start": 51.34357498146501,
      "end": 55.17581213300712,
      "text": "教师侧依据错因分层，再结合目标编排教学。",
      "width": 640.0
    },
    {
      "start": 55.64052428454923,
      "end": 63.53645675415184,
      "text": "课程工具与模型服务支持这些操作，师生在各自工作区执行活动，新的作答和反馈继续回流。",
      "width": 1312.0
    },
    {
      "start": 65.70154099999999,
      "end": 70.44070699999999,
      "text": "师生各有工作区，课程与学习记录在两端保持关联。",
      "width": 736.0
    },
    {
      "start": 74.068541,
      "end": 76.127332,
      "text": "从陈星河的一次错题开始。",
      "width": 384.0
    },
    {
      "start": 76.621625,
      "end": 82.095375,
      "text": "系统记录这次错误，呈现知识状态、证据量和继续学习的入口。",
      "width": 896.0
    },
    {
      "start": 82.58812499999999,
      "end": 87.27574899999999,
      "text": "路径读取个人目标和时间预算，安排具体的前置活动。",
      "width": 768.0
    },
    {
      "start": 93.148541,
      "end": 98.351666,
      "text": "课程网络连接当前概念与前置知识，方便学生定位。",
      "width": 736.0
    },
    {
      "start": 98.845958,
      "end": 102.902166,
      "text": "压入四十八再弹出，结构和返回值同步变化。",
      "width": 640.0
    },
    {
      "start": 103.394916,
      "end": 107.50266599999999,
      "text": "学生带上原题和操作记录，继续讨论自己的困惑。",
      "width": 704.0
    },
    {
      "start": 112.33854099999999,
      "end": 114.551958,
      "text": "这次请求使用官方模型。",
      "width": 352.0
    },
    {
      "start": 115.046291,
      "end": 119.19266599999999,
      "text": "解释结合课程材料与附件，并给出理解检查。",
      "width": 640.0
    },
    {
      "start": 119.685458,
      "end": 123.41945799999999,
      "text": "打开引用，可以查看上传的丙牌操作记录。",
      "width": 608.0
    },
    {
      "start": 123.91225,
      "end": 129.012291,
      "text": "学生完成检查，评分结果保存到原有会话和学习记录。",
      "width": 768.0
    },
    {
      "start": 132.768541,
      "end": 138.564416,
      "text": "回看这段解释，模型用甲乙丙牌说明最后压入的元素为什么先离开。",
      "width": 960.0
    },
    {
      "start": 139.05875,
      "end": 143.952541,
      "text": "学生既能看到对应材料，也能通过下一道题检查自己的理解。",
      "width": 864.0
    },
    {
      "start": 144.445333,
      "end": 147.212874,
      "text": "辅导围绕这名学生的具体错误展开。",
      "width": 512.0
    },
    {
      "start": 150.968541,
      "end": 154.354624,
      "text": "历史会话保留原题、引用和检查。",
      "width": 480.0
    },
    {
      "start": 154.84895799999998,
      "end": 158.31237399999998,
      "text": "学生再次打开时，可以接着同一个问题学习。",
      "width": 640.0
    },
    {
      "start": 161.968541,
      "end": 168.35720799999999,
      "text": "教师从知识矩阵进入陈星河的作答，把班级状态追溯到具体题目。",
      "width": 928.0
    },
    {
      "start": 168.851541,
      "end": 176.966999,
      "text": "随后要求安排三十分钟讲评课，教学助手读取班级证据，组织教学环节与群组任务。",
      "width": 1184.0
    },
    {
      "start": 177.459791,
      "end": 183.590708,
      "text": "教师修改方案标题，核对活动安排，保存为可继续编辑的课程教案。",
      "width": 960.0
    },
    {
      "start": 184.0835,
      "end": 186.851,
      "text": "方案经过校验，等待教师确认。",
      "width": 448.0
    },
    {
      "start": 192.434541,
      "end": 194.29999899999999,
      "text": "教师端面向整个班级。",
      "width": 320.0
    },
    {
      "start": 194.794333,
      "end": 200.693291,
      "text": "方案分为五分钟发现问题、十五分钟对照追踪和十分钟迁移复测。",
      "width": 928.0
    },
    {
      "start": 201.186083,
      "end": 209.726791,
      "text": "群组与题目来自课程工具，时间和对象由程序校验，教师据此判断哪些内容适合这次教学。",
      "width": 1280.0
    },
    {
      "start": 212.034541,
      "end": 216.000541,
      "text": "发布表单带入五名学生，其中包括陈星河。",
      "width": 608.0
    },
    {
      "start": 216.49487499999998,
      "end": 220.641249,
      "text": "教师确认目标学生与题目，再发布独立复测任务。",
      "width": 704.0
    },
    {
      "start": 222.868541,
      "end": 228.200499,
      "text": "陈星河接收该任务，独立选择答案并提交，记录保留任务标识。",
      "width": 896.0
    },
    {
      "start": 228.694833,
      "end": 235.482958,
      "text": "教师查看同一任务的结果，确认他已经完成，并对照新增作答和发布前后的状态。",
      "width": 1152.0
    },
    {
      "start": 235.97575,
      "end": 242.016457,
      "text": "随后继续发起反馈，请学生解释两种移出顺序，并举出生活中的例子。",
      "width": 992.0
    },
    {
      "start": 242.50925,
      "end": 248.485541,
      "text": "这几步通过同一课程、学生和任务相互关联，便于回看后续学习。",
      "width": 928.0
    },
    {
      "start": 253.56854099999998,
      "end": 258.75874899999997,
      "text": "学生回到课堂互动，写下对栈和队列的理解，再提交自己的例子。",
      "width": 928.0
    },
    {
      "start": 259.253083,
      "end": 261.363416,
      "text": "教师随后查看这条回答。",
      "width": 352.0
    },
    {
      "start": 261.856166,
      "end": 268.451041,
      "text": "一次错误经过材料、辅导、复测和反馈，形成了前后对应的教学过程。",
      "width": 992.0
    },
    {
      "start": 268.943791,
      "end": 272.664916,
      "text": "每一步都保存具体的课程对象与实际记录。",
      "width": 608.0
    },
    {
      "start": 277.06854100000004,
      "end": 279.72008300000005,
      "text": "课程建设也可以接入新的主题。",
      "width": 448.0
    },
    {
      "start": 280.214416,
      "end": 286.75770800000004,
      "text": "这里是通过正常接口创建的信息素养微单元，讲义讨论怎样追溯消息来源。",
      "width": 1056.0
    },
    {
      "start": 287.25050000000005,
      "end": 295.57216600000004,
      "text": "学生进入新知识和习题，老师发布任务、查看结果并继续反馈，同一套流程沿用到新内容。",
      "width": 1280.0
    },
    {
      "start": 299.934541,
      "end": 304.171166,
      "text": "Python课程同样提供视频、知识关系和练习。",
      "width": 653.0
    },
    {
      "start": 304.665458,
      "end": 309.610833,
      "text": "方法效果则用可运行对照检查：四十八个相同约束案例中，",
      "width": 832.0
    },
    {
      "start": 309.871666,
      "end": 318.219082,
      "text": "路径搜索相对可行贪心取得三十六胜、九平、三负，平均目标值提高约百分之三点四九。",
      "width": 1248.0
    },
    {
      "start": 318.711875,
      "end": 321.492291,
      "text": "每个案例及结果都随源码提供。",
      "width": 448.0
    },
    {
      "start": 325.201541,
      "end": 330.958749,
      "text": "接下来回看三条真实开发链，先看课程对象与权限的协作指令。",
      "width": 896.0
    },
    {
      "start": 331.45308300000005,
      "end": 336.759249,
      "text": "Codex先固定接口契约，前后端与人工智能模块共用课程标识。",
      "width": 895.0
    },
    {
      "start": 337.252041,
      "end": 342.120083,
      "text": "联测发现初始化错误，三个路由测试被同一个数据问题阻断。",
      "width": 864.0
    },
    {
      "start": 342.61287500000003,
      "end": 347.35204100000004,
      "text": "反馈后，代码将知识点种子的八个占位符修正为七个。",
      "width": 768.0
    },
    {
      "start": 347.83195800000004,
      "end": 354.07887400000004,
      "text": "修复后的登录、图谱和作答返回实际结果，记录进入同一数据库。",
      "width": 928.0
    },
    {
      "start": 354.57166600000005,
      "end": 360.61237500000004,
      "text": "中文提交保留数据初始化和课程授权，后续功能沿用这些对象。",
      "width": 896.0
    },
    {
      "start": 361.10516600000005,
      "end": 364.800499,
      "text": "师生页面由此能够继续使用同一份课程记录。",
      "width": 640.0
    },
    {
      "start": 370.201541,
      "end": 372.31183200000004,
      "text": "第二条来自知识网络。",
      "width": 320.0
    },
    {
      "start": 372.806166,
      "end": 376.669083,
      "text": "原始要求是改善拥挤的布局与阅读体验。",
      "width": 576.0
    },
    {
      "start": 377.161875,
      "end": 382.815957,
      "text": "实际几何检查发现九处连线遮挡，问题被保留在验证记录里。",
      "width": 864.0
    },
    {
      "start": 383.295875,
      "end": 388.885583,
      "text": "Codex增加空白通道搜索，使受阻连线继续寻找可用路径。",
      "width": 831.0
    },
    {
      "start": 389.378333,
      "end": 395.457708,
      "text": "两门真实课程和不同规模网络使用固定输入，分别检查几何结果。",
      "width": 928.0
    },
    {
      "start": 395.95050000000003,
      "end": 400.61233300000004,
      "text": "改进后，全部案例的节点碰撞与连线遮挡均为零。",
      "width": 704.0
    },
    {
      "start": 401.09225000000004,
      "end": 406.901041,
      "text": "代码、固定输入和结果一起提交，再检查页面中的相机与全屏。",
      "width": 896.0
    },
    {
      "start": 407.393791,
      "end": 410.844291,
      "text": "相同输入可以再次执行，逐项核对。",
      "width": 512.0
    },
    {
      "start": 415.201541,
      "end": 420.86854100000005,
      "text": "第三条核查教师要求，一句指令同时包含班级错误与教学设计。",
      "width": 896.0
    },
    {
      "start": 421.36287500000003,
      "end": 427.017,
      "text": "专项测试真实失败，系统只返回学情分析，遗漏讲评课产物。",
      "width": 864.0
    },
    {
      "start": 427.509791,
      "end": 433.69225,
      "text": "Codex调整优先级，先识别教学产物，再使用班级错误作为证据。",
      "width": 927.0
    },
    {
      "start": 434.185041,
      "end": 440.135583,
      "text": "同一专项重新执行，两项通过，教学设计与轻量讨论分别核查。",
      "width": 896.0
    },
    {
      "start": 440.628333,
      "end": 446.02474900000004,
      "text": "随后验证既有业务和双端页面，回归结果保留当时的执行记录。",
      "width": 896.0
    },
    {
      "start": 446.51754100000005,
      "end": 452.468041,
      "text": "中文提交保存修复，真实教学方案继续进入任务发布和学生反馈。",
      "width": 928.0
    },
    {
      "start": 460.201541,
      "end": 465.85566600000004,
      "text": "学脉希望让学生的下一步学习有据可循，让教师接得住每一次反馈。",
      "width": 960.0
    },
    {
      "start": 466.35,
      "end": 469.69741600000003,
      "text": "我的介绍到这里，感谢各位评委老师观看。",
      "width": 608.0
    }
  ]
}